<%- include('partials/head', { badge: 'Демо-режим', badgeTone: 'warning' }) %>
    <div class="pay__card">
<%- include('partials/summary') %>
      <form class="pay__body" method="post" action="/pay/mock/<%= payment.provider_tx_id %>" data-testid="mock-pay-form">
        <%- csrfField %>
        <div class="bankcard" aria-label="Тестовая карта">
          <div class="bankcard__top"><span>Тестовая карта</span><span>Samo Pay</span></div>
          <div class="bankcard__chip" aria-hidden="true"></div>
          <div>
            <p class="bankcard__number">8600 4954 7331 6478</p>
            <dl class="bankcard__row">
              <div><dt>Срок</dt><dd>03/29</dd></div>
              <div><dt>Код из SMS</dt><dd>666 666</dd></div>
            </dl>
          </div>
        </div>
        <div class="pay__actions">
          <button class="btn btn--primary btn--lg btn--block" name="action" value="success" data-testid="mock-pay-success">Оплатить <%= formatSum(order.total) %></button>
          <div class="pay__alt">
            <button class="btn btn--ghost pay__decline" name="action" value="fail" data-testid="mock-pay-fail">Отклонить</button>
            <button class="btn btn--ghost" name="action" value="cancel" data-testid="mock-pay-cancel">Вернуться в магазин</button>
          </div>
        </div>
      </form>
    </div>
    <p class="pay__note">Тестовая платёжная страница: деньги не списываются, данные карты вводить не нужно. «Оплатить» имитирует успешный платёж, «Отклонить» — отказ банка.</p>
<%- include('partials/foot') %>
