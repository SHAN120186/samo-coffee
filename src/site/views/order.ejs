<%- include('partials/head', { bodyClass: 'page-order' }) %>
<%
  const tone = { paid: 'success', processing: 'success', shipped: 'success', delivered: 'success', pending: 'warning', failed: 'danger', cancelled: 'muted', refunded: 'muted' }[state] || 'warning';
  const stateIcon = { success: 'check', warning: 'clock', danger: 'x', muted: state === 'refunded' ? 'refresh' : 'x' }[tone];
  const paymentBadge = { paid: 'success', pending: 'warning', unpaid: 'warning', failed: 'danger', refunded: 'info' }[order.payment_status] || 'warning';
-%>

<main id="main">
  <section class="order-hero order-hero--<%= tone %>">
    <div class="container container--narrow">
      <div class="order-hero__icon" aria-hidden="true"><%- icon(stateIcon, { size: 30 }) %></div>
      <p class="eyebrow">Заказ <span data-testid="order-number"><%= order.number %></span> · <%= formatDate(order.created_at) %></p>
      <h1 class="order-hero__title"><%= title %></h1>
<% if (text) { -%>
      <p class="lead order-hero__text"><%= text %></p>
<% } -%>
      <p class="order-hero__badges">
        <span class="badge badge--dark" data-testid="order-status"><%= order.status_label %></span>
        <span class="badge badge--<%= paymentBadge %>">Оплата: <span data-testid="payment-status"><%= order.payment_status_label %></span></span>
      </p>
<% if (order.can_pay) { -%>
      <p class="order-hero__actions">
        <a class="btn btn--primary btn--lg" href="<%= order.pay_url %>" data-testid="pay-order"><%= state === 'failed' ? 'Попробовать ещё раз' : 'Оплатить' %> · <%= formatSum(order.total) %></a>
      </p>
<% } else if (order.is_paid) { -%>
      <p class="order-hero__actions">
        <a class="btn btn--dark btn--lg" href="/catalog">Продолжить покупки</a>
<% if (tgOrderLink) { -%>
        <a class="btn btn--ghost btn--lg" href="<%= tgOrderLink %>" target="_blank" rel="noopener"><%- icon('telegram', { size: 18 }) %>Статус в Telegram</a>
<% } -%>
      </p>
<% } else { -%>
      <p class="order-hero__actions"><a class="btn btn--dark btn--lg" href="/catalog">В каталог</a></p>
<% } -%>
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container container--narrow">
<% if (steps.length) { -%>
      <ol class="steps-line" aria-label="Этапы заказа">
<% steps.forEach((step) => { -%>
        <li class="steps-line__item<%= step.done ? ' is-done' : '' %><%= step.current ? ' is-current' : '' %>"<% if (step.current) { %> aria-current="step"<% } %>>
          <span class="steps-line__dot" aria-hidden="true"><% if (step.done) { %><%- icon('check', { size: 14 }) %><% } %></span>
          <span class="steps-line__label"><%= step.label %></span>
        </li>
<% }) -%>
      </ol>
<% } -%>

<% if (subscription) { -%>
      <div class="alert alert--success order-sub">
        Подписка «<%= subscription.plan_title %>» активна до <strong><%= formatDate(subscription.current_period_end) %></strong>.
      </div>
<% } -%>

      <div class="order-card">
        <h2 class="order-card__title">Состав заказа</h2>
        <ul class="summary__items">
<% order.items.forEach((item) => { -%>
          <li class="summary__item">
            <img src="<%= item.image || '/img/placeholder.svg' %>" alt="" width="96" height="96" loading="lazy">
            <span class="summary__item-title"><%= item.title %><small><%= item.qty %> × <%= formatSum(item.price) %></small></span>
            <span class="price"><%= formatSum(item.total) %></span>
          </li>
<% }) -%>
        </ul>
        <dl class="summary__rows">
          <div class="summary__row"><dt><%= order.kind === 'subscription' ? 'Подписка' : 'Товары' %></dt><dd><%= formatSum(order.subtotal) %></dd></div>
          <div class="summary__row"><dt>Доставка</dt><dd><%= order.delivery_fee ? formatSum(order.delivery_fee) : 'Бесплатно' %></dd></div>
          <div class="summary__row summary__row--total"><dt>Итого</dt><dd data-testid="order-total"><%= formatSum(order.total) %></dd></div>
        </dl>
      </div>

      <div class="order-card">
        <h2 class="order-card__title">Детали</h2>
        <dl class="specs specs--plain">
          <div><dt>Получатель</dt><dd><%= order.customer_name %><% if (order.customer_phone) { %>, <span class="num" style="white-space: nowrap"><%= formatPhone(order.customer_phone) %></span><% } %></dd></div>
          <div><dt>Получение</dt><dd><%= order.delivery_method_label %><% if (order.delivery_method === 'pickup') { %> — <%= settings.pickup_address %><% } else if (order.delivery_address) { %> — <%= order.delivery_address %><% } %></dd></div>
<% if (order.comment) { -%>
          <div><dt>Комментарий</dt><dd><%- nl2br(order.comment) %></dd></div>
<% } -%>
<% if (order.paid_at) { -%>
          <div><dt>Оплачен</dt><dd><%= formatDateTimeFull(order.paid_at) %></dd></div>
<% } -%>
        </dl>
      </div>

<% if (c.help_text) { -%>
      <p class="order-help">
        <%= c.help_text %>
<% if (settings.phone) { -%>
        <a href="<%= telHref(settings.phone) %>"><%= settings.phone %></a>
<% } -%>
        <span aria-hidden="true">·</span> <a href="/contacts#form">Написать</a>
      </p>
<% } -%>
    </div>
  </section>
</main>

<% if (order.can_pay && order.payment_status === 'pending') { -%>
<div hidden data-order-poll="/order/<%= order.public_token %>/status" data-order-state="<%= order.status %>:<%= order.payment_status %>"></div>
<% } -%>

<%- include('partials/foot') %>
