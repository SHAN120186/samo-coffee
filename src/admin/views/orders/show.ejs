<%- include('../partials/head') %>
<div class="page-head">
  <div>
    <a class="back-link" href="/admin/orders"><%- icon('left', 14) %> Все заказы</a>
    <h1>Заказ <%= order.number %></h1>
    <p class="page-head__sub status-line">
      <span class="<%= badgeClass('order', order.status) %>"><%= order.status_label %></span>
      <span class="<%= badgeClass('payment', order.payment_status) %>"><%= order.payment_status_label %></span>
      <span class="<%= badgeClass('channel', order.channel) %>"><%= order.channel_label %></span>
      <span>создан <%= formatDateTimeFull(order.created_at) %></span>
    </p>
  </div>
  <div class="page-head__actions">
    <a class="btn" href="<%= order.url %>" target="_blank" rel="noopener"><%- icon('external', 15) %> Страница заказа для клиента</a>
  </div>
</div>

<div class="cols cols--main">
  <div class="stack-4">
    <section class="panel">
      <div class="panel__head"><h2><%= order.kind === 'subscription' ? 'Подписка' : 'Состав заказа' %></h2><span class="muted"><%= order.kind_label %></span></div>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Позиция</th><th class="num">Цена</th><th class="num">Кол-во</th><th class="num">Сумма</th></tr></thead>
          <tbody>
            <% order.items.forEach((item) => { %>
              <tr>
                <td>
                  <div class="cell-product">
                    <img class="thumb" src="<%= item.image || '/img/placeholder.svg' %>" alt="" loading="lazy" width="44" height="44">
                    <div>
                      <% if (item.product_id) { %><a class="t-main" href="/admin/products/<%= item.product_id %>"><%= item.title %></a>
                      <% } else if (item.plan_id) { %><a class="t-main" href="/admin/plans/<%= item.plan_id %>"><%= item.title %></a>
                      <% } else { %><span class="t-main"><%= item.title %></span><span class="t-sub">позиция удалена из каталога</span><% } %>
                    </div>
                  </div>
                </td>
                <td class="num"><%= formatSum(item.price) %></td>
                <td class="num"><%= item.qty %></td>
                <td class="num"><%= formatSum(item.total) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="order-sum">
        <div><span>Товары</span><span class="num"><%= formatSum(order.subtotal) %></span></div>
        <div><span>Доставка</span><span class="num"><%= order.delivery_fee ? formatSum(order.delivery_fee) : 'бесплатно' %></span></div>
        <% if (order.discount) { %><div><span>Скидка</span><span class="num">−<%= formatSum(order.discount) %></span></div><% } %>
        <div class="total"><span>Итого</span><span class="num"><%= formatSum(order.total) %></span></div>
      </div>
    </section>

    <section class="panel">
      <div class="panel__head"><h2>Платежи</h2></div>
      <% if (payments.length) { %>
        <div class="table-wrap">
          <table class="table table--compact">
            <thead><tr><th>Провайдер</th><th>Транзакция</th><th>Статус</th><th>Создан</th><th>Проведён</th><th class="num">Сумма</th></tr></thead>
            <tbody>
              <% const payLabels = { created: 'Создан', pending: 'Ожидает', paid: 'Оплачен', cancelled: 'Отменён', failed: 'Ошибка', refunded: 'Возвращён' }; %>
              <% payments.forEach((p) => { %>
                <tr>
                  <td><%= providerLabels[p.provider] || p.provider %></td>
                  <td><% if (p.provider_tx_id) { %><code title="<%= p.provider_tx_id %>"><%= truncate(p.provider_tx_id, 22) %></code><% } else { %><span class="muted-dash">—</span><% } %><% if (p.error) { %><span class="t-sub"><%= p.error %></span><% } %></td>
                  <td><span class="<%= badgeClass('payment', p.status) %>"><%= payLabels[p.status] || p.status %></span></td>
                  <td class="t-nowrap"><%= formatDateTime(p.created_at) %></td>
                  <td class="t-nowrap"><%= p.perform_time ? formatDateTime(p.perform_time) : '—' %></td>
                  <td class="num"><%= formatSum(p.amount) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty empty--sm"><span class="empty__title">Попыток оплаты не было</span><p>Клиент ещё не переходил к оплате. Ссылка на оплату есть на странице заказа.</p></div>
      <% } %>
    </section>

    <section class="panel">
      <div class="panel__head"><h2>История</h2></div>
      <div class="panel__body">
        <ol class="timeline">
          <% [...events].reverse().forEach((e) => { %>
            <li class="is-<%= e.type %>">
              <div class="timeline__title">
                <% if (e.type === 'created') { %>Заказ оформлен
                <% } else if (e.type === 'payment') { %>Оплата: <%= e.to_label %>
                <% } else if (e.type === 'status') { %><%= e.from_label %> → <%= e.to_label %>
                <% } else { %>Заметка<% } %>
              </div>
              <div class="timeline__meta"><%= formatDateTimeFull(e.created_at) %> · <%= e.actor_label %></div>
              <% if (e.note) { %><div class="timeline__note"><%= e.note %></div><% } %>
            </li>
          <% }) %>
        </ol>
        <form method="post" action="/admin/orders/<%= order.id %>/comment" style="margin-top: var(--space-4); display: flex; gap: var(--space-2)">
          <%- csrfField %>
          <label class="visually-hidden" for="order-comment">Запись в историю</label>
          <input class="input" type="text" id="order-comment" name="note" maxlength="500" placeholder="Добавить запись в историю: звонок клиенту, договорённость…" required>
          <button class="btn" type="submit">Добавить</button>
        </form>
      </div>
    </section>
  </div>

  <div class="stack-4">
    <section class="panel">
      <div class="panel__head"><h2>Управление заказом</h2></div>
      <div class="panel__body stack-4">
        <% if (nextStatuses.length) { %>
          <form method="post" action="/admin/orders/<%= order.id %>/status" class="stack-4">
            <%- csrfField %>
            <div class="field">
              <label class="field__label" for="next-status">Перевести в статус</label>
              <select class="select" id="next-status" name="status">
                <% nextStatuses.forEach((t) => { %><option value="<%= t.status %>"><%= t.label %></option><% }) %>
              </select>
            </div>
            <div class="field">
              <label class="field__label" for="status-note">Комментарий для истории</label>
              <input class="input" type="text" id="status-note" name="note" maxlength="500" placeholder="Необязательно">
            </div>
            <button class="btn btn--primary btn--block" type="submit">Изменить статус</button>
          </form>
        <% } else if (!canMarkPaid && !canCancel && !canRefund) { %>
          <p class="muted" style="margin: 0">Заказ в финальном статусе «<%= order.status_label %>» — дальнейшие действия недоступны.</p>
        <% } %>

        <% if (canMarkPaid || canCancel || canRefund) { %>
          <div class="btn-row"<%- nextStatuses.length ? ' style="padding-top: var(--space-4); border-top: 1px solid var(--adm-line)"' : '' %>>
            <% if (canMarkPaid) { %>
              <form method="post" action="/admin/orders/<%= order.id %>/mark-paid" data-confirm="Отметить заказ <%= order.number %> оплаченным вручную? <%= order.kind === 'subscription' ? 'Подписка клиента будет активирована.' : 'Остатки товаров будут списаны.' %>" data-confirm-ok="Отметить оплаченным" data-confirm-tone="primary">
                <%- csrfField %><button class="btn btn--dark" type="submit"><%- icon('check', 15) %> Отметить оплаченным</button>
              </form>
            <% } %>
            <% if (canCancel) { %>
              <form method="post" action="/admin/orders/<%= order.id %>/cancel" data-confirm="Отменить заказ <%= order.number %>? Клиент не сможет его оплатить." data-confirm-ok="Отменить заказ">
                <%- csrfField %><button class="btn btn--danger-quiet" type="submit">Отменить заказ</button>
              </form>
            <% } %>
            <% if (canRefund) { %>
              <form method="post" action="/admin/orders/<%= order.id %>/refund" data-confirm="Оформить возврат по заказу <%= order.number %>? <%= order.kind === 'subscription' ? 'Оплаченный период подписки будет отменён.' : 'Товары вернутся на склад.' %> Деньги нужно вернуть отдельно — в кабинете платёжного провайдера." data-confirm-ok="Оформить возврат">
                <%- csrfField %><button class="btn btn--danger-quiet" type="submit">Оформить возврат</button>
              </form>
            <% } %>
          </div>
        <% } %>

        <% if (nextStatuses.length || canMarkPaid || canCancel || canRefund) { %>
          <p class="help" style="margin: var(--space-3) 0 0">
            <% if (notifiable) { %><%- icon('telegram', 13) %> Клиент получит уведомление в Telegram об оплате и смене статуса.
            <% } else { %><%- icon('info', 13) %> Заказ оформлен без Telegram — уведомления не отправляются, свяжитесь с клиентом по телефону.<% } %>
          </p>
        <% } %>
      </div>
    </section>

    <section class="panel">
      <div class="panel__head">
        <h2>Клиент</h2>
        <% if (customer) { %><a class="panel__link" href="/admin/customers/<%= customer.id %>">Профиль</a><% } %>
      </div>
      <div class="panel__body">
        <dl class="dl">
          <dt>Имя</dt><dd><%= order.customer_name || '—' %></dd>
          <dt>Телефон</dt><dd><% if (order.customer_phone) { %><a href="tel:<%= order.customer_phone %>"><%= formatPhone(order.customer_phone) %></a><% } else { %>—<% } %></dd>
          <% if (order.customer_email) { %><dt>E-mail</dt><dd><a href="mailto:<%= order.customer_email %>"><%= order.customer_email %></a></dd><% } %>
          <% if (customer && customer.tg_username) { %><dt>Telegram</dt><dd><a href="https://t.me/<%= customer.tg_username %>" target="_blank" rel="noopener">@<%= customer.tg_username %></a></dd><% } %>
          <% if (customerStats) { %><dt>Заказов</dt><dd><%= customerStats.orders_count %>, оплачено на <%= formatSum(customerStats.paid_total) %></dd><% } %>
          <% if (order.source) { %><dt>Источник</dt><dd><%= order.source %></dd><% } %>
        </dl>
        <% if (subscription) { %>
          <p class="help" style="margin: var(--space-3) 0 0">Подписка «<%= subscription.plan_title %>»: <span class="<%= badgeClass('subscription', subscription.status) %>"><%= subscription.status_label %></span> до <%= formatDateShort(subscription.current_period_end) %></p>
        <% } %>
      </div>
    </section>

    <section class="panel">
      <div class="panel__head"><h2>Доставка</h2></div>
      <div class="panel__body">
        <dl class="dl">
          <dt>Способ</dt><dd><%= order.delivery_method_label %></dd>
          <dt>Адрес</dt><dd><%= order.delivery_method === 'pickup' ? settings.pickup_address : (order.delivery_address || '—') %></dd>
          <% if (order.comment) { %><dt>Комментарий</dt><dd><%- nl2br(order.comment) %></dd><% } %>
        </dl>
      </div>
    </section>

    <section class="panel">
      <div class="panel__head"><h2>Заметка для команды</h2></div>
      <form class="panel__body" method="post" action="/admin/orders/<%= order.id %>/note">
        <%- csrfField %>
        <label class="visually-hidden" for="admin-note">Заметка</label>
        <textarea class="textarea" id="admin-note" name="admin_note" rows="3" maxlength="2000" placeholder="Видна только в админ-панели"><%= order.admin_note %></textarea>
        <button class="btn btn--sm" type="submit" style="margin-top: var(--space-2)">Сохранить заметку</button>
      </form>
    </section>
  </div>
</div>
<%- include('../partials/foot') %>
