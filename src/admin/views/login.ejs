<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> — Админ-панель <%= settings.site_name %></title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/tokens.css?v=<%= assetV %>">
  <link rel="stylesheet" href="/admin/css/admin.css?v=<%= assetV %>">
</head>
<body class="adm">
<div class="login">
  <aside class="login__aside">
    <img src="/img/logo-light.svg" alt="<%= settings.site_name %>" width="150" height="36">
    <div class="login__quote">
      <h2>Весь магазин — в одной панели</h2>
      <p>Заказы, каталог, тексты сайта, обращения из Telegram и аналитика продаж.</p>
    </div>
    <ul class="login__list">
      <li><%- icon('chart', 16) %> Аналитика посещений и выручки</li>
      <li><%- icon('layout', 16) %> Редактор текстов и изображений сайта</li>
      <li><%- icon('chat', 16) %> Ответы клиентам через Telegram-бота</li>
    </ul>
  </aside>
  <main class="login__main">
    <div class="login__card">
      <p class="eyebrow">Админ-панель</p>
      <h1>Вход</h1>
      <p class="muted">Введите e-mail и пароль администратора.</p>

      <% const _flash = flash; %>
      <% if (locals.error || _flash.length) { %>
        <div class="flashes" role="alert" style="margin: var(--space-4) 0 0">
          <% if (locals.error) { %><div class="alert alert--error"><%- icon('alert', 16) %><span><%= error %></span></div><% } %>
          <% _flash.forEach((f) => { %><div class="alert alert--<%= f.type %>"><span><%= f.message %></span></div><% }) %>
        </div>
      <% } %>

      <form method="post" action="/admin/login" novalidate>
        <%- csrfField %>
        <input type="hidden" name="next" value="<%= next %>">
        <div class="field">
          <label class="field__label" for="login-email">E-mail</label>
          <input class="input" id="login-email" type="email" name="email" value="<%= email %>" autocomplete="username" required autofocus>
        </div>
        <div class="field">
          <label class="field__label" for="login-password">Пароль</label>
          <input class="input" id="login-password" type="password" name="password" autocomplete="current-password" required>
        </div>
        <button class="btn btn--primary btn--block" type="submit">Войти</button>
      </form>

      <% if (demoHint) { %>
        <p class="login__demo">Демо-режим: <code><%= demoHint.email %></code> / <code><%= demoHint.password %></code>. Подсказка видна только вне production — задайте <code>ADMIN_PASSWORD</code> перед запуском.</p>
      <% } %>
      <p style="margin-top: var(--space-5)"><a class="back-link" href="/"><%- icon('left', 14) %> Вернуться на сайт</a></p>
    </div>
  </main>
</div>
</body>
</html>
