<%- include('../partials/head') %>
<div class="page-head">
  <div>
    <h1>Администраторы</h1>
    <p class="page-head__sub">Кто имеет доступ к панели. Владелец управляет всем, администратор — всем, кроме учётных записей, менеджер — заказами, каталогом, контентом и обращениями.</p>
  </div>
  <div class="page-head__actions">
    <a class="btn btn--primary" href="/admin/admins/new"><%- icon('plus', 15) %> Добавить администратора</a>
  </div>
</div>

<section class="panel">
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Администратор</th><th>Роль</th><th>Статус</th><th>Последний вход</th><th>Добавлен</th><th><span class="visually-hidden">Действия</span></th></tr></thead>
      <tbody>
        <% admins.forEach((a) => { %>
          <tr class="<%= a.active ? '' : 'is-muted' %>">
            <td><a class="t-main" href="/admin/admins/<%= a.id %>"><%= a.name || a.email %></a><% if (a.id === admin.id) { %> <span class="badge badge--accent">это вы</span><% } %><span class="t-sub"><%= a.email %></span></td>
            <td><span class="<%= a.role === 'owner' ? 'badge badge--dark' : a.role === 'admin' ? 'badge badge--info' : 'badge' %>"><%= a.role_label %></span></td>
            <td><span class="<%= a.active ? 'badge badge--success' : 'badge badge--danger' %>"><%= a.active ? 'Активен' : 'Отключён' %></span></td>
            <td class="t-nowrap"><%= a.last_login_at ? formatDateTimeFull(a.last_login_at) : 'ещё не входил' %></td>
            <td class="t-nowrap"><%= formatDateShort(a.created_at) %></td>
            <td class="t-actions">
              <a class="btn btn--sm btn--quiet btn--icon" href="/admin/admins/<%= a.id %>" title="Редактировать" aria-label="Редактировать"><%- icon('edit', 15) %></a>
              <% if (a.id !== admin.id) { %>
                <form method="post" action="/admin/admins/<%= a.id %>/delete" data-confirm="Удалить администратора <%= a.email %>? Он сразу потеряет доступ к панели.">
                  <%- csrfField %><button class="btn btn--sm btn--quiet btn--icon" type="submit" title="Удалить" aria-label="Удалить"><%- icon('trash', 15) %></button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/foot') %>
