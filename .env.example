# ───────────────────────────── Samo Coffee — environment ─────────────────────────────
# Copy to .env and adjust. Every variable is optional in development:
# the app boots with an empty .env (mock payments, bot disabled).

# ── Core ─────────────────────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
# HTTP port of the single process (site + admin + API + mini app + bot)
PORT=3000
# Public origin WITHOUT trailing slash. Used in payment return URLs, bot links, webhook URL.
# Must be https:// in production (Telegram Mini Apps and webhooks require HTTPS).
BASE_URL=http://localhost:3000
# SQLite file (created automatically). ":memory:" is supported for tests.
DATABASE_PATH=./data/samo.db
# Secret for signed cookies / CSRF. REQUIRED in production (16+ random chars).
SESSION_SECRET=
# Number of reverse proxies in front of the app (Express "trust proxy"). Default: 1 in production.
TRUST_PROXY=
# Offset from UTC (minutes) used to group analytics by business day. Tashkent = 300.
TZ_OFFSET_MINUTES=300
# Set to 0 to turn first-party analytics off.
ANALYTICS_ENABLED=1

# ── Admin panel ──────────────────────────────────────────────────────────────────────
# The first admin is created from these values when the admins table is empty.
ADMIN_EMAIL=admin@samo.coffee
# Dev default is "admin12345"; in production a value is required for the first boot.
ADMIN_PASSWORD=
# Admin session lifetime in days.
ADMIN_SESSION_DAYS=14

# ── Uploads ──────────────────────────────────────────────────────────────────────────
# Where uploaded media is stored (must be inside public/ or served as /uploads).
UPLOAD_DIR=./public/uploads
# Max upload size in megabytes.
UPLOAD_MAX_MB=5

# ── Telegram bot ─────────────────────────────────────────────────────────────────────
# Token from @BotFather. Empty = bot, notifications and Mini App auth are disabled.
BOT_TOKEN=
# Bot username without @ (for t.me links and deep links).
BOT_USERNAME=
# Chat id (user or group) that receives new-order and feedback notifications.
# Admins answer customers by replying to forwarded messages in this chat.
ADMIN_CHAT_ID=
# Bot API root. Change only for a local Bot API server or tests (fake server).
TELEGRAM_API_ROOT=https://api.telegram.org
# polling (default, works anywhere) | webhook (needs public HTTPS BASE_URL)
BOT_MODE=polling
# Secret token checked in the X-Telegram-Bot-Api-Secret-Token header (webhook mode).
WEBHOOK_SECRET=

# ── Telegram Mini App ────────────────────────────────────────────────────────────────
# 1 = allow opening /tma in a normal browser as a demo user. Ignored in production.
TMA_DEV_AUTH=0
# Max age of WebApp initData in seconds (freshness check).
TMA_INITDATA_MAX_AGE=86400
# Public URL of the Mini App (defaults to BASE_URL/tma/).
TMA_URL=

# ── Payments ─────────────────────────────────────────────────────────────────────────
# Default provider: mock | telegram | payme | click
# (can also be switched in Admin → Settings; the setting wins over this variable)
PAYMENT_PROVIDER=mock

# Telegram Payments: provider token from @BotFather → Payments (Click / Payme / test).
TELEGRAM_PAYMENT_TOKEN=

# Payme Business (https://developer.help.paycom.uz)
# Merchant (cash register) id from the Payme cabinet.
PAYME_MERCHANT_ID=
# Merchant API key (use the TEST key while PAYME_TEST=1).
PAYME_KEY=
# 1 = sandbox (checkout.test.paycom.uz), 0 = production (checkout.paycom.uz)
PAYME_TEST=1
# Name of the account field configured for the cash register.
PAYME_ACCOUNT_FIELD=order_id
# Merchant API endpoint to register in the cabinet: {BASE_URL}/pay/payme

# Click SHOP API (https://docs.click.uz)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
# Callback URLs to register: {BASE_URL}/pay/click/prepare and {BASE_URL}/pay/click/complete
